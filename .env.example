# Prefer `jev-classifier setup` for interactive global configuration.
# After setup, use --env-file .env to explicitly load this project override.
# Jev classifier backend: typesafe, openrouter, or vercel
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
# OPENROUTER_API_KEY=
# AI_GATEWAY_API_KEY=
# Optional overrides for the selected Jev backend:
# JEV_API_KEY=
# JEV_MODEL=

# 1 = route without Jev (first unused tool), no API key needed
JEV_STUB=0

# enforce = rewrite tool_choice ; shadow = classify + log only
JEV_MODE=enforce

# 0 = launch agents directly without Jev or its gateway (run only)
# Or use: jev-classifier proxy off / proxy on / run claude --no-proxy
JEV_PROXY=1

DONE_THRESHOLD=0.5
MIN_CONFIDENCE=0.5
PORT=8080
# JEV_DEFAULT_AGENT=codex
# Agents: codex, claude, grok, opencode, cursor, antigravity.
# OpenCode uses API-key providers. Cursor/Antigravity use MCP advice (connect <editor>).
# JEV_AUTH=oauth
# JEV_SYSTEM_CA=1

ANTHROPIC_UPSTREAM=https://api.anthropic.com
OPENAI_UPSTREAM=https://api.openai.com
XAI_UPSTREAM=https://api.x.ai

JEV_LOG=.jev-classifier/decisions.jsonl

# Optional API-route overrides for the supported agents (not classifier configuration):
# UPSTREAM=
# UPSTREAM_API_KEY=

# OAuth: log in using the agent, then print its setup:
# node dist/cli.js config claude
# node dist/cli.js config codex
# node dist/cli.js config grok
# /oauth/* routes preserve session headers and IGNORE UPSTREAM / UPSTREAM_API_KEY.
# No OAuth secrets belong in this file. The agent refreshes its own login.
# Optional trusted session-service overrides (full base before the request suffix):
# CLAUDE_OAUTH_UPSTREAM=https://api.anthropic.com
# CODEX_OAUTH_UPSTREAM=https://chatgpt.com/backend-api/codex
# GROK_OAUTH_UPSTREAM=https://cli-chat-proxy.grok.com
# Before setup, .env is loaded automatically. Saved global preferences take over after setup.
